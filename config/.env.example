# Skopíruj ako config/.env a doplň heslo.
DATABASE_URL=postgres://rejnox_app:HESLO@localhost:5432/rejnox

# Adresy proxy (Next.js web v webapp/, cloudflared), ktorým server verí
# hlavičky s IP klienta. Bez nich zdieľajú všetci návštevníci webu jeden limit
# pokusov o prihlásenie. Server berie poslednú adresu z x-forwarded-for.
TRUSTED_PROXIES=127.0.0.1,::1

# Len ak je API dostupné výhradne cez Cloudflare (napr. Cloudflare Tunnel):
# IP klienta sa potom vezme z hlavičky, ktorú Cloudflare vždy prepíše.
# Bez Cloudflare nechaj zakomentované, inak by si ju klient mohol podvrhnúť.
# CLIENT_IP_HEADER=cf-connecting-ip
