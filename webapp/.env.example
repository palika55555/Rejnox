# Rejnox web + API (Next.js na Cloudflare Workers, databáza Supabase).
# Tento súbor je len vzor. Skutočné hodnoty patria do .env.local / .env
# (v gite nie sú) a na Cloudflare do Secrets. Heslá nikdy nedávaj do kódu.

# --- Aplikácia (.env.local lokálne, na Cloudflare: Settings → Variables and secrets → Secret)
# Pripája sa ako rola rejnox_app, na ktorú platia pravidlá RLS.
# Lokálne:   postgres://rejnox_app:HESLO@localhost:5432/rejnox
# Supabase:  Connect → Transaction pooler, používateľ rejnox_app.<project-ref>
DATABASE_URL=postgres://rejnox_app.PROJEKT:HESLO@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Migrácie (.env lokálne pre `npm run db:*`, na Cloudflare: Settings → Build → Variables and secrets)
# Vlastník schémy (postgres), Supabase Connect → Session pooler (port 5432).
MIGRATION_DATABASE_URL=postgres://postgres.PROJEKT:HESLO@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
