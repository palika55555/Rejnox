# Skopíruj ako .env.local. Adresa Dart API servera (server/), ktorý zdieľa
# mobilná appka aj web. Volá sa len zo servera Next.js, prehliadač ju nevidí.
REJNOX_API_URL=http://127.0.0.1:8080

# Počet proxy pred Next.js, ktoré pripisujú IP do x-forwarded-for (Vercel,
# nginx…). Podľa toho web zistí skutočnú IP návštevníka pre limit pokusov.
# Lokálne bez proxy nechaj 1: adresu vtedy doplní sám Next.js.
WEB_PROXY_HOPS=1
